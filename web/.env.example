# Public REST API used by server components (and by the browser for the live stream)
ATLAS_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ATLAS_API_URL=http://127.0.0.1:8000
# Shared secret for POST /api/revalidate (sent by the pipeline when a snapshot is committed)
ATLAS_REVALIDATE_SECRET=change-me
# Public origin of the website (canonical and hreflang URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Price provider of the API for company charts: yfinance (development), synthetic or none
# ATLAS_PRICE_PROVIDER=yfinance
