# Public REST API used by server components (and by the browser for the live stream)
ATLAS_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ATLAS_API_URL=http://127.0.0.1:8000
# Shared secret for POST /api/revalidate (sent by the pipeline when a snapshot is committed)
ATLAS_REVALIDATE_SECRET=change-me
# Live stream: the Go realtime-gateway (infra/compose.yaml); defaults to the API's own /v1/stream
NEXT_PUBLIC_ATLAS_STREAM_URL=http://localhost:8090
# Sign-in (Keycloak, public client with PKCE) and the alerts API, for /account/watchlist
NEXT_PUBLIC_ATLAS_OIDC_ISSUER=http://localhost:8180/realms/atlas
NEXT_PUBLIC_ATLAS_OIDC_CLIENT_ID=atlas-web
NEXT_PUBLIC_ATLAS_ALERTS_URL=http://localhost:8091
