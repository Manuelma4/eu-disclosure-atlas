    "/v1/stats/overview": {
      "get": {
        "tags": [
          "stats"
        ],
        "summary": "Overview",
        "operationId": "overview_v1_stats_overview_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Overview"
                }
              }
            }
          }
        }
      }
    },
    "/v1/stats/flow": {
      "get": {
        "tags": [
          "stats"
        ],
        "summary": "Flow",
        "description": "Open-market insider buying and selling (EUR) per period, by transaction date.",
        "operationId": "flow_v1_stats_flow_get",
        "parameters": [
          {
            "name": "bucket",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "day",
                "week",
                "month"
              ],
              "type": "string",
              "default": "week",
              "title": "Bucket"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 3660,
              "minimum": 7,
              "default": 182,
              "title": "Days"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Country"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlowPoint"
                  },
                  "title": "Response Flow V1 Stats Flow Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/stream": {
      "get": {
        "tags": [
          "stream"
        ],
        "summary": "Stream",
        "operationId": "stream_v1_stream_get",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Resume after this event id",
              "title": "Since"
            },
            "description": "Resume after this event id"
          }
        ],
        "responses": {
          "200": {
            "description": "`filing` events, newest last",
            "content": {
              "text/event-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
