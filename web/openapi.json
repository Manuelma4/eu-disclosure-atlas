{
  "openapi": "3.1.0",
  "info": {
    "title": "EU Disclosure Atlas API",
    "description": "\nOpen, unified data on insider trading (MAR Article 19) and short selling (SSR Article 6) across European\nmarkets. Natural persons appear only as pseudonymous ids. Every response is pinned to a data snapshot,\nexposed in the `ETag` and `X-Atlas-Snapshot` headers. Not investment advice.\n",
    "contact": {
      "name": "Manuel David Maya Rosero",
      "url": "https://manuelma4.github.io/"
    },
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sources": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Sources",
        "operationId": "sources_v1_sources_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SourceStatus"
                  },
                  "type": "array",
                  "title": "Response Sources V1 Sources Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/insider-transactions": {
      "get": {
        "tags": [
          "insider-transactions"
        ],
        "summary": "List Transactions",
        "operationId": "list_transactions_v1_insider_transactions_get",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO country codes, repeatable",
              "title": "Country"
            },
            "description": "ISO country codes, repeatable"
          },
          {
            "name": "issuer_lei",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Issuer Lei"
            }
          },
          {
            "name": "isin",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Isin"
            }
          },
          {
            "name": "nature",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "buy, sell, grant, ... repeatable",
              "title": "Nature"
            },
            "description": "buy, sell, grant, ... repeatable"
          },
          {
            "name": "role",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "ceo, cfo, chair, ... repeatable",
              "title": "Role"
            },
            "description": "ceo, cfo, chair, ... repeatable"
          },
          {
            "name": "open_market",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Open Market"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Published on or after (YYYY-MM-DD)",
              "title": "Since"
            },
            "description": "Published on or after (YYYY-MM-DD)"
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Published on or before (YYYY-MM-DD)",
              "title": "Until"
            },
            "description": "Published on or before (YYYY-MM-DD)"
          },
          {
            "name": "min_amount_eur",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Min Amount Eur"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Issuer name contains",
              "title": "Q"
            },
            "description": "Issuer name contains"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_Transaction_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/insider-transactions/{record_id}": {
      "get": {
        "tags": [
          "insider-transactions"
        ],
        "summary": "Get Transaction",
        "operationId": "get_transaction_v1_insider_transactions__record_id__get",
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
