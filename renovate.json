{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled",
    "helpers:pinGitHubActionDigests",
    ":maintainLockFilesWeekly"
  ],
  "timezone": "Europe/Paris",
  "schedule": ["before 7am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 8,
  "vulnerabilityAlerts": { "labels": ["security"], "schedule": ["at any time"] },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "OpenTelemetry moves in lockstep across SDKs and the Collector",
      "groupName": "OpenTelemetry",
      "matchPackageNames": ["/opentelemetry/", "@vercel/otel", "otel/opentelemetry-collector-contrib"]
    },
    {
      "description": "Grafana observability stack images",
      "groupName": "observability stack",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["grafana/**", "prom/**", "ghcr.io/slok/sloth"]
    },
    {
      "description": "Next.js, React and their types together",
      "groupName": "Next.js and React",
      "matchPackageNames": ["next", "eslint-config-next", "react", "react-dom", "@types/react", "@types/react-dom"]
    },
    {
      "description": "GitHub Actions: minor and patch updates merge once CI is green",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Go toolchain and modules of the Go services",
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images invoked with docker run in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["(?<depName>(?:ghcr\\.io/)?[a-z0-9./-]+):(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "docker"
    }
  ]
}
