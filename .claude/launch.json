{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/disclosure-atlas",
      "runtimeArgs": ["--lake", "lake", "serve", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "api-fixture",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ATLAS_PRICE_PROVIDER=synthetic",
        "ATLAS_CORS_ORIGINS=http://localhost:3005,http://127.0.0.1:3005",
        ".venv/bin/disclosure-atlas", "--lake", "web/e2e/.lake", "serve", "--port", "8005"
      ],
      "port": 8005
    },
    {
      "name": "web-fixture",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ATLAS_API_URL=http://127.0.0.1:8005",
        "NEXT_PUBLIC_ATLAS_API_URL=http://127.0.0.1:8005",
        "npm", "--prefix", "web", "run", "dev", "--", "--port", "3005"
      ],
      "port": 3005
    }
  ]
}
