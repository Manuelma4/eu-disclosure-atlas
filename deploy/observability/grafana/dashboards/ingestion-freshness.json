{
  "uid": "atlas-ingestion-freshness",
  "title": "Ingestion: freshness per source",
  "description": "Filings visible within 15 minutes of publication (SLO 95%), last ingestion per source, late and backfilled filings.",
  "tags": [
    "atlas",
    "ingestion",
    "freshness"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 1,
  "links": [
    {
      "title": "Runbooks",
      "type": "link",
      "targetBlank": true,
      "url": "https://github.com/Manuelma4/eu-disclosure-atlas/tree/main/docs/runbooks"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Freshness SLO",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "bargauge",
      "title": "On time, 30 days, by source",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - slo:sli_error:ratio_rate30d{sloth_id=\"ingestion-filing-freshness\"}",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "id": 2
    },
    {
      "type": "table",
      "title": "Minutes since last ingestion",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(time() - max by (source) (atlas_source_last_ingested_seconds)) / 60",
          "legendFormat": "{{source}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 1560
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 3
    },
    {
      "type": "row",
      "title": "Filings",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Filings ingested per hour by timeliness",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source, timeliness) (increase(atlas_source_filings_total[1h]))",
          "legendFormat": "{{source}} {{timeliness}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Error budget burn rate (1h)",
      "description": "1 burns the budget exactly over 30 days; 14.4 pages.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:sli_error:ratio_rate1h{sloth_id=\"ingestion-filing-freshness\"} / on (source) group_left slo:error_budget:ratio{sloth_id=\"ingestion-filing-freshness\"}",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Lag between latest publication and latest ingestion",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (source) (atlas_source_last_ingested_seconds) - max by (source) (atlas_source_last_published_seconds)",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 7
    }
  ]
}
