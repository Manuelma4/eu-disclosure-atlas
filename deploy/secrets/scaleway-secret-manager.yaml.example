# The one bootstrap secret: the Scaleway API key External Secrets uses to read Scaleway Secret Manager.
# cp scaleway-secret-manager.yaml.example scaleway-secret-manager.enc.yaml, fill it in, then
# sops --encrypt --in-place scaleway-secret-manager.enc.yaml and commit the encrypted file.
apiVersion: v1
kind: Secret
metadata:
  name: scaleway-secret-manager
  namespace: external-secrets
type: Opaque
stringData:
  access-key: SCWXXXXXXXXXXXXXXXXX
  secret-key: 00000000-0000-0000-0000-000000000000
