# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
build/
dist/

# Local data lake (bronze holds raw regulator files and is never published)
lake/
*.duckdb
*.duckdb.wal
*.ducklake
*.ducklake.wal

# Dagster local state (dagster dev)
.dagster/
.tmp_dagster_home_*/
exports/

# Secrets
.env
.pseudonym_key

# OS / editors
.DS_Store
.vscode/
.idea/

# Deploy: rendered manifests, packaged chart dependencies, local cluster state
deploy/.rendered/
deploy/helm/*/charts/
.k3d/
infra/tofu/**/.terraform/
infra/tofu/**/*.tfstate*
infra/tofu/**/*.tfplan
infra/tofu/modules/*/.terraform.lock.hcl

# Evaluation run reports (regenerated; summarize notable runs in evals/*/README.md)
evals/*/results/

# Local assistant and editor tooling (kept on the developer machine, not in the repository)
CLAUDE.md
AGENTS.md
.claude/
